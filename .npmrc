# KASANE Desktop npm/pnpm config.
# See https://pnpm.io/settings for the canonical list of pnpm settings.

# esbuild and @swc/core ship native binaries that must be downloaded
# during install. Approving them up-front keeps `pnpm install` non-interactive
# and works on both pnpm 9 (CI default) and pnpm 10/11 (bundled runtime).
only-built-dependencies[]=esbuild
only-built-dependencies[]=@swc/core
